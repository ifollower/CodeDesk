# CodeDesk public build metadata. Copy this file to .env and fill in the
# values before producing a release. The root .env is build-time input only;
# it is not bundled into CodeDesk applications.
# Do not put server private keys, signing certificates, or API secrets here.
CODEDESK_SOURCE_URL=
CODEDESK_ISSUES_URL=
CODEDESK_WEBSITE_URL=
CODEDESK_DOWNLOAD_URL=
CODEDESK_PRIVACY_URL=

# Context-specific documentation links may point to the same documentation
# home page until dedicated pages are available.
CODEDESK_DOCS_URL=
CODEDESK_DOCS_MOBILE_URL=
CODEDESK_DOCS_LINUX_PERMISSIONS_URL=
CODEDESK_DOCS_X11_URL=
CODEDESK_DOCS_LINUX_LOGIN_URL=
CODEDESK_DOCS_HEADLESS_URL=
CODEDESK_DOCS_WHITELIST_URL=

# Leave either endpoint empty to disable the related client feature.
CODEDESK_API_URL=
CODEDESK_UPDATE_API_URL=

# Comma-separated hbbs hosts, with optional ports. Do not include URL schemes.
CODEDESK_RENDEZVOUS_SERVERS=
# Base64-encoded Ed25519 public key paired with the configured hbbs service.
CODEDESK_RENDEZVOUS_PUBLIC_KEY=
