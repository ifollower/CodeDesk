[Unit]
Description=CodeDesk Rendezvous Server
After=network.target

[Service]
Type=simple
LimitNOFILE=1000000
ExecStart=/usr/bin/hbbs
WorkingDirectory=/var/lib/codedesk-server/
User=
Group=
Restart=always
StandardOutput=append:/var/log/codedesk-server/hbbs.log
StandardError=append:/var/log/codedesk-server/hbbs.error
RestartSec=10

[Install]
WantedBy=multi-user.target
